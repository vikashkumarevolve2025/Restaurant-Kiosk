# Copy to .env and edit. Never commit .env.

# Required. The kitchen screen and staff endpoints ask for this PIN.
STAFF_PIN=change-me

SHOP_NAME=Karam Kitchen
SHOP_ADDRESS=12 Residency Road, Bengaluru
SHOP_GSTIN=29ABCDE1234F1Z5
GST_PERCENT=5
TABLE_COUNT=3
TIMEZONE=Asia/Kolkata

# The public address guests reach, used inside the table QR codes.
PUBLIC_URL=https://order.example.com
# Set to 1 only when the server sits behind your own proxy or tunnel.
TRUST_PROXY=0

# Printing: none | file | network | usb | windows
PRINTER=file
# PRINTER_NAME=POS-80        # for PRINTER=windows; empty means the default printer
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# PRINTER_USB_VENDOR=0x04b8
# PRINTER_USB_PRODUCT=0x0e15
PRINTER_COLS=42

DB_PATH=data/orders.db
PRINT_DIR=prints

# Optional owner PIN for /admin (menu, prices, reports). If empty, STAFF_PIN is used.
ADMIN_PIN=

# Optional: let the owner edit shop name, address, GST, tables, printer, guest address and PINs
# on screen (Admin, Tools). Saved there; those values then override the ones above.
# CONFIG_FILE=data/settings.json
